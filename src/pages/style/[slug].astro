---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HubPage from "../../components/HubPage.astro";
import { liveMembers, hubPages } from "../../lib/taxonomy";
import { hubMetaDescription } from "../../lib/hubcopy";

export function getStaticPaths() {
  return liveMembers("style").map((member) => ({
    params: { slug: member.slug },
    props: { member, pages: hubPages("style", member.slug) },
  }));
}
const { member, pages } = Astro.props;
---
<BaseLayout
  title={`${member.label} Coloring Page Collections | Free PDFs`}
  description={hubMetaDescription("style", member.slug, member.label)}
>
  <HubPage axisKey="style" member={member} pages={pages} />
</BaseLayout>

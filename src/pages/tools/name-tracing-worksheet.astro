---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorksheetShell from "../../components/WorksheetShell.astro";
import SheetControls from "../../components/SheetControls.astro";
import { generatorBySlug } from "../../lib/worksheets";

const gen = generatorBySlug.get("name-tracing-worksheet")!;
---
<BaseLayout
  title={gen.title}
  description={gen.description}
  image={`/images/worksheets/${gen.slug}.png`}
>
  <WorksheetShell gen={gen}>
    <Fragment slot="controls">
      <label>Name
        <input type="text" data-p="name" maxlength="40" value="Emma" placeholder="Type a name" />
        <span class="hint" id="name-hint"></span>
      </label>
      <SheetControls
        show={["rows", "style"]}
        more={["font", "caps", "guides", "color", "orient"]}
        rowsDefault="5"
      />
    </Fragment>
  </WorksheetShell>
</BaseLayout>

<script>
  import { mountTool } from "../../lib/sheetkit";
  import { draws, cleanName } from "../../lib/draws";

  mountTool({
    file: "name-tracing-worksheet",
    params: [
      { name: "name", def: "Emma" },
      { name: "rows", def: "5" },
      { name: "style", def: "dotted" },
      { name: "font", def: "school" },
      { name: "caps", def: "yes" },
      { name: "guides", def: "yes" },
      { name: "color", def: "#111111" },
      { name: "orient", def: "portrait" },
    ],
    draw: draws["name-tracing-worksheet"],
    onRender(p) {
      // Long names wrap onto two lines rather than being cut off; say so,
      // because the parent would otherwise only find out after printing.
      const el = document.getElementById("name-hint");
      if (!el) return;
      const n = cleanName(p.name, "Name", p.caps !== "no");
      el.textContent = n.length > 12 ? "Long name: it will print on two lines" : "";
    },
  });
</script>

<style>
  .hint { font-family: var(--font-body); font-weight: 400; font-size: 0.76rem; color: var(--orange-dark); min-height: 1em; }
</style>

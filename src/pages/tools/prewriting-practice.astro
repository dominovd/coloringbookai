---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorksheetShell from "../../components/WorksheetShell.astro";
import SheetControls from "../../components/SheetControls.astro";
import { generatorBySlug } from "../../lib/worksheets";

const gen = generatorBySlug.get("prewriting-practice")!;
---
<BaseLayout
  title={gen.title}
  description={gen.description}
  image={`/images/worksheets/${gen.slug}.png`}
>
  <WorksheetShell gen={gen}>
    <Fragment slot="controls">
      <label>Pattern
        <select data-p="pattern">
          <option value="lines">Straight lines</option>
          <option value="waves">Waves</option>
          <option value="zigzag">Zigzags</option>
          <option value="loops">Loops</option>
          <option value="spirals">Spirals</option>
          <option value="arches">Arches</option>
          <option value="mixed">Mixed set</option>
        </select>
      </label>
      <label>Difficulty
        <select data-p="level">
          <option value="easy">Easy (big)</option>
          <option value="medium">Medium</option>
          <option value="hard">Small</option>
        </select>
      </label>
      <SheetControls show={["rows"]} more={["color", "orient"]} rowsDefault="6" />
    </Fragment>
  </WorksheetShell>
</BaseLayout>

<script>
  import { mountTool } from "../../lib/sheetkit";
  import { draws } from "../../lib/draws";

  mountTool({
    file: "prewriting-practice",
    params: [
      { name: "pattern", def: "lines" },
      { name: "level", def: "easy" },
      { name: "rows", def: "6" },
      { name: "color", def: "#111111" },
      { name: "orient", def: "portrait" },
    ],
    draw: draws["prewriting-practice"],
  });
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorksheetShell from "../../components/WorksheetShell.astro";
import SheetControls from "../../components/SheetControls.astro";
import { generatorBySlug } from "../../lib/worksheets";

const gen = generatorBySlug.get("word-tracing-worksheet")!;
---
<BaseLayout
  title={gen.title}
  description={gen.description}
  image={`/images/worksheets/${gen.slug}.png`}
>
  <WorksheetShell gen={gen}>
    <Fragment slot="controls">
      <label>Words (space separated)
        <input type="text" data-p="words" maxlength="80" value="the and said was you" />
      </label>
      <SheetControls show={["style"]} more={["font", "guides", "color", "orient"]} />
    </Fragment>
  </WorksheetShell>
</BaseLayout>

<script>
  import { mountTool } from "../../lib/sheetkit";
  import { draws } from "../../lib/draws";

  mountTool({
    file: "word-tracing-worksheet",
    params: [
      { name: "words", def: "the and said was you" },
      { name: "style", def: "dotted" },
      { name: "font", def: "school" },
      { name: "guides", def: "yes" },
      { name: "color", def: "#111111" },
      { name: "orient", def: "portrait" },
    ],
    draw: draws["word-tracing-worksheet"],
  });
</script>

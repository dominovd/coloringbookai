---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorksheetShell from "../../components/WorksheetShell.astro";
import SheetControls from "../../components/SheetControls.astro";
import { generatorBySlug } from "../../lib/worksheets";

const gen = generatorBySlug.get("number-tracing-worksheet")!;
---
<BaseLayout
  title={gen.title}
  description={gen.description}
  image={`/images/worksheets/${gen.slug}.png`}
>
  <WorksheetShell gen={gen}>
    <Fragment slot="controls">
      <label>Range
        <select data-p="range">
          <option value="10">1 to 10</option>
          <option value="20">1 to 20</option>
          <option value="50">1 to 50</option>
          <option value="100">1 to 100</option>
        </select>
      </label>
      <label>Number words
        <select data-p="words">
          <option value="no">Digits only</option>
          <option value="yes">Digit + word</option>
        </select>
      </label>
      <SheetControls show={["style"]} more={["font", "guides", "color", "orient"]} />
    </Fragment>
  </WorksheetShell>
</BaseLayout>

<script>
  import { mountTool } from "../../lib/sheetkit";
  import { draws } from "../../lib/draws";

  mountTool({
    file: "number-tracing-worksheet",
    params: [
      { name: "range", def: "10" },
      { name: "words", def: "no" },
      { name: "style", def: "dotted" },
      { name: "font", def: "school" },
      { name: "guides", def: "yes" },
      { name: "color", def: "#111111" },
      { name: "orient", def: "portrait" },
    ],
    draw: draws["number-tracing-worksheet"],
  });
</script>

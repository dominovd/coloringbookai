---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ColoringPageTemplate from "../../components/ColoringPageTemplate.astro";
import { publishedPages } from "../../lib/taxonomy";
import { metaTitle, metaDescription } from "../../lib/pagecopy";

// One static page per PUBLISHED keyword. Add slugs to PUBLISHED (taxonomy.ts)
// to go live wave by wave, drafts in the CSV never render.
export function getStaticPaths() {
  return publishedPages().map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<BaseLayout
  title={metaTitle(page)}
  description={metaDescription(page)}
  image={`/images/${page.slug}/composite.png`}
>
  <ColoringPageTemplate page={page} />
</BaseLayout>

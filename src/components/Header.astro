---
import Logo from "./Logo.astro";
import { nav } from "../data/content";
---
<header class="site-header">
  <div class="container bar">
    <Logo />
    <nav class="nav" aria-label="Primary">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a href="/pages/" class="btn btn-ghost btn-sm browse-all">Browse all</a>
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" aria-label="Mobile">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/pages/" class="btn btn-orange btn-sm">Browse all pages</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255, 253, 250, 0.92);
    backdrop-filter: saturate(1.1) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 66px; }
  .nav { display: flex; gap: 26px; margin-left: 20px; }
  .nav a {
    font-family: var(--font-head); font-weight: 500; font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .nav a:hover { color: var(--teal-dark); }
  .browse-all { margin-left: auto; }
  .menu-toggle {
    display: none; margin-left: auto; background: none; border: 0;
    flex-direction: column; gap: 5px; cursor: pointer; padding: 8px;
  }
  .menu-toggle span { width: 22px; height: 2px; background: var(--ink); border-radius: 2px; }
  .mobile-nav { display: none; flex-direction: column; gap: 4px; padding: 10px 20px 18px; border-top: 1px solid var(--line); }
  .mobile-nav a { padding: 10px 4px; font-family: var(--font-head); font-weight: 500; color: var(--ink); }
  .mobile-nav.open { display: flex; }

  @media (max-width: 860px) {
    .nav, .browse-all { display: none; }
    .menu-toggle { display: flex; }
  }
</style>

<script>
  const btn = document.querySelector(".menu-toggle");
  const menu = document.querySelector(".mobile-nav");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(!!open));
  });
</script>
